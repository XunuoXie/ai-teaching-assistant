# ============================================
# 复制本文件为 .env 后填入真实配置
#   cp .env.example .env
# 切勿将 .env 提交到版本库
# ============================================

# ---------- Flask 后端 ----------
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Flask session 签名密钥，生产环境务必替换为随机字符串
SECRET_KEY=change-this-to-a-random-secret

# ---------- 角色与分班 ----------
# 默认教师用户名：学生注册时自动加入该教师名下的默认班级
DEFAULT_TEACHER_USERNAME=teacher

# 学习通教师 CPI 白名单（逗号分隔，命中的 CPI 注册时自动赋予教师角色）
XUETANG_TEACHER_CPIS=

# 前端公网地址（学习通 SSO 回跳使用）
FRONTEND_URL=http://localhost:3000

# ---------- LLM API ----------
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEFAULT_MODEL=deepseek-v4-flash

# ---------- 超时配置（秒） ----------
API_TIMEOUT=300
CODE_EXECUTION_TIMEOUT=600

# ---------- Vite 前端开发服务器（仅 npm run dev 需要） ----------
VITE_DEV_PORT=3000
VITE_API_TARGET=http://localhost:5000
